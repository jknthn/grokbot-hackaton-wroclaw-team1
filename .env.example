JOIN_PIN=4821
PORT=3000
# Local: 127.0.0.1 (default). Deploy: 0.0.0.0 (also auto when NODE_ENV=production)
HOST=127.0.0.1
NODE_ENV=development
AUTO_BOT=1
BOT_NAME=Grok-1
# GROK_API_KEY=
# GROK_MODEL=grok-2-latest
# builtin (default): each town join seats an in-process shadow bot.
# mcp: that loop stays off. External agents join only through MCP.
AGENT_TRANSPORT=builtin
# Long random secret for POST /api/mcp/agents. Unset disables provisioning.
# Never commit a real value, put it in a URL, or ship it to the browser.
# MCP_PROVISION_SECRET=
# MCP_TOOL_RATE_LIMIT=40
# MCP_TOOL_RATE_WINDOW_MS=10000
